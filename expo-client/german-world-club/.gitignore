# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
# The app is an npm workspace: the ROOT package-lock.json is the one that
# resolves it. A lockfile here is a leftover from create-expo-app and would
# be a second, silently stale, answer to the same question.
package-lock.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
german-world-club-b103ddfadefe.json
# Firebase service-account keys (feature 011, research R8). The FCM V1 key
# lives in EAS credentials and nowhere else: it can send to every member's
# phone, so a copy in the project folder is one `git add .` from a leak.
# google-services.json (the *client* config) is NOT matched and is committed.
*-firebase-adminsdk*.json
german-world-club-*.json
