# Every value here is validated by src/config/env.js at startup.
# An invalid or missing value prevents boot rather than degrading behaviour
# (Constitution: Technology & Security Baseline).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL ---------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/gwc_dev

# --- Redis --------------------------------------------------------------------
# Rate-limit buckets and the session revocation denylist. In development a
# single process makes per-instance limits equivalent to distributed ones; in a
# deployed environment they are NOT, so this is required there.
# REDIS_ENABLED decides whether the client is registered at all; false runs
# on the in-memory fallbacks even with REDIS_URL set. Must be true in production.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# --- Token signing (EdDSA / Ed25519) ------------------------------------------
# Generate with: npm run -w server keys:generate
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- Deployment preconditions -------------------------------------------------
# These three have NO safe default. Production boot fails when they are unset.
#
# CANONICAL_ORIGIN — the one host+scheme served. Every other variant 301s here,
#   and every absolute og:image URL is built from it. A wrong value breaks every
#   link preview.
CANONICAL_ORIGIN=http://localhost:3000
#
# TRUST_PROXY — the number of proxy hops in front of this server.
#   Too low: every client keys to the proxy address and per-address rate limits
#   do nothing. Set to `true`: a client can forge X-Forwarded-For and bypass
#   every limit. Must match the real deployment.
TRUST_PROXY=0
#
# KEEP_ALIVE_TIMEOUT_MS — must EXCEED the proxy's idle timeout, or the proxy
#   reuses a socket this server is closing and sporadic 502s appear.
KEEP_ALIVE_TIMEOUT_MS=72000

# --- Timeouts (see contracts/resilience.md §1) --------------------------------
REQUEST_TIMEOUT_MS=30000
CONNECTION_TIMEOUT_MS=35000

# --- Server fault records (feature 012) ----------------------------------------
# Unexpected 500s are stored in server_faults. Per instance, per minute; beyond
# this they are counted in server_fault_suppressions instead of stored in full.
SERVER_FAULTS_PER_MINUTE=60

# --- Media storage ------------------------------------------------------------
# driver: "local" for development, "s3" for deployed environments
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_PATH=./var/media
MEDIA_MAX_BYTES=26214400
MEDIA_MAX_PIXELS=50000000

# --- SMSGlobal (OTP delivery, §6.2) -------------------------------------------
# Without these, OTP sends are refused loudly rather than silently skipped —
# a second factor that quietly does not send is not a second factor.
SMSGLOBAL_API_KEY=
SMSGLOBAL_API_SECRET=
SMSGLOBAL_ORIGIN=GWC

# --- Push notifications -------------------------------------------------------
# Expo needs no server credential unless the project enables enhanced security.
EXPO_ACCESS_TOKEN=
# FCM service account. The private key is a secret: keep it here or in a secret
# manager, never as a JSON file committed to the repo.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
