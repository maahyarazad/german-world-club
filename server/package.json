{
  "name": "@gwc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.ts up",
    "migrate:down": "node --env-file-if-exists=.env src/db/migrate.ts down",
    "seed:demo": "node --env-file-if-exists=.env src/scripts/seed-demo.ts",
    "seed:dev": "node --env-file-if-exists=.env src/scripts/seed-dev.ts",
    "keys:generate": "node --env-file-if-exists=.env src/scripts/keys-generate.ts",
    "token:mint": "node --env-file-if-exists=.env src/scripts/token-mint.ts",
    "verify:seo": "node --env-file-if-exists=.env src/scripts/verify-seo.ts"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/etag": "^6.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/redis": "^9.0.0",
    "@fastify/request-context": "^7.0.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/under-pressure": "^9.1.0",
    "@gwc/contracts": "*",
    "argon2": "^0.45.1",
    "close-with-grace": "^2.5.0",
    "croner": "^10.0.1",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^22.1.0",
    "opossum": "^10.0.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.32.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "ulid": "^3.0.2",
    "undici": "^8.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "vitest": "^5.0.0"
  }
}
